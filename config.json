{
  "scan_directories": [],
  "repositories": [
    {
      "name": "example-project",
      "path": "C:/Users/YOURNAME/projects/example-project",
      "exclude_patterns": ["*.log", "node_modules/", ".env"]
    },
    {
      "name": "another-project",
      "path": "/home/yourname/projects/another-project",
      "schedule": { "type": "interval", "hours": 0, "minutes": 15 }
    }
  ],
  "schedule": {
    "type": "interval",
    "hours": 0,
    "minutes": 30
  },
  "commit_message_template": "Automated check-in: {name} at {timestamp}",
  "log_file": "auto_checkin.log",
  "protected_branches": ["main", "master", "develop"],
  "push": {
    "enabled": false,
    "remote": "origin",
    "branch_prefix": "wip/yourname/"
  }
}
